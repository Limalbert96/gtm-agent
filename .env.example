# Copy to .env (ADK auto-loads a .env next to the agent package). .env is gitignored.
# Claude is the model backend via ADK's LiteLLM wrapper.

# ---------------------------------------------------------------------------
# AUTH (public default): set your Anthropic API key. Nothing else is required.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Optional: pick a different model (LiteLLM id form "provider/name").
# Default in code: anthropic/claude-sonnet-4-20250514
# GTM_MODEL=anthropic/claude-opus-4-20250514

# Optional: cap output tokens (default 8192).
# GTM_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# GOOGLE GEMINI (alternative hosted backend). Set GTM_MODEL to a gemini/ id and
# provide a key from https://aistudio.google.com/apikey. No other change needed.
# Uses ADK's native Gemini client, not LiteLLM. Nothing else to configure.
# ---------------------------------------------------------------------------
#   GTM_MODEL=gemini/gemini-2.5-pro       # or gemini/gemini-2.5-flash (cheaper/faster)
#   GEMINI_API_KEY=AIza...

# Optional: brand the product the agents sell (default "our platform").
# GTM_PRODUCT_NAME=Acme Observability

# ---------------------------------------------------------------------------
# LOCAL MODELS (Ollama / LM Studio / vLLM) via LiteLLM.
# Set GTM_MODEL to a non-anthropic provider and the Anthropic path is bypassed.
# This is a tool-calling multi-agent system, so pick a model with solid
# function-calling support. Good approved-license choices: qwen3, qwen2.5,
# mistral, llama3.1. Smaller models may fumble delegation and tool arguments.
# ---------------------------------------------------------------------------
# Ollama (run `ollama serve` and `ollama pull qwen3` first):
#   GTM_MODEL=ollama_chat/qwen3
#   GTM_LOCAL_BASE_URL=http://localhost:11434   # only if not the default port
#
# LM Studio / vLLM (OpenAI-compatible server):
#   GTM_MODEL=openai/qwen3
#   GTM_LOCAL_BASE_URL=http://localhost:1234/v1
#   GTM_LOCAL_API_KEY=lm-studio                 # dummy key some servers require


# ---------------------------------------------------------------------------
# OPTIONAL: OpenTelemetry export (see gtm_agent/observability.py + README).
# Sends traces, metrics, and logs to any OTLP backend. Install requirements-otel.txt.
# Opt out of a signal with GTM_OTEL_METRICS=0 / GTM_OTEL_LOGS=0.
# ---------------------------------------------------------------------------
# New Relic (US). Use an ingest License key (ends NRAL), not a user key (NRAK-...).
# _HEADERS takes just the key -- observability.py sends it as the "api-key" header.
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
#   OTEL_EXPORTER_OTLP_HEADERS=YOUR_INGEST_LICENSE_KEY
#   OTEL_SERVICE_NAME=gtm-agent
#   OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4095
#   OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT=4095
#
# Show prompts/responses in New Relic's AI monitoring UI. Without these, ADK only
# writes its legacy gcp.vertex.agent.llm_request/llm_response attributes, which that
# UI doesn't read -- so "User input" and "Response" render as <empty>. The capture
# mode defaults to NO_CONTENT, so both vars are required (SPAN_ONLY = spans only).
#   OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
#   OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
# Local OpenTelemetry Collector:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------------------
# OPTIONAL: internal gateway (see the INTERNAL GATEWAY block in gtm_agent/auth.py).
# Only if you route Claude through a corporate proxy that mints a short-lived
# token. OFF unless GTM_USE_INTERNAL_GATEWAY=1. Put real values in your local
# .env only -- never commit them.
# ---------------------------------------------------------------------------
# GTM_USE_INTERNAL_GATEWAY=1
# GTM_KEY_COMMAND=/path/to/token-command
# GTM_BASE_URL=https://your-internal-gateway.example.com
