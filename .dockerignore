# Keep the build context small and keep secrets / local artifacts out of the image.

.git
.gitignore
**/__pycache__
*.py[cod]
.DS_Store
**/.DS_Store

# Secrets & local env — NEVER bake these into the image. Use Space Secrets instead.
.env
.env.*
!.env.example

# Node deps & any locally-built SPA. The image builds its own in a clean Linux
# stage, which also avoids the macOS/Linux rollup optional-dep mismatch.
**/node_modules
web/frontend/dist

# Private, internal-only playbook content (gitignored — keep it out of images too).
gtm_agent/playbooks/private/
playbooks/private/

# Virtualenvs / caches / ADK local state
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
.adk
**/.adk
*.session.db
